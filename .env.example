# ==============================================================================
# LIVEHUB PLATFORM - MASTER CONFIGURATION & API REGISTRATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Dùng Postgres local qua Docker hoặc Database miễn phí trên Neon.tech / Supabase:
# Neon Serverless Postgres (Khuyên dùng khi deploy Cloudflare):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/livehub?schema=public"

# ------------------------------------------------------------------------------
# 2. CACHING & REAL-TIME STATE (Redis / Upstash Serverless)
# ------------------------------------------------------------------------------
# Upstash Redis Free Tier (10,000 requests/ngày miễn phí, cực phù hợp Cloudflare):
REDIS_URL="redis://localhost:6379"
# Tùy chọn nếu dùng Upstash REST API trên Edge Functions:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 3. SEPAY VIETQR PAYMENT GATEWAY & WEBHOOK CONFIGURATION
# ------------------------------------------------------------------------------
# Lấy tại: https://my.sepay.vn/webhooks
# 1. Điền API Key của SePay (trong mục Cấu hình API / Webhook):
SEPAY_API_KEY="your-sepay-api-key-here"

# 2. Thông tin số tài khoản ngân hàng nhận tiền mặc định của Creator:
SEPAY_DEFAULT_BANK="MBBank"
SEPAY_DEFAULT_ACC="03810002009"
SEPAY_DEFAULT_NAME="BUI VAN THU NOOB"

# 3. Webhook Endpoint của bạn cần điền vào dashboard my.sepay.vn:
# https://yourdomain.com/api/webhooks/sepay
SEPAY_WEBHOOK_URL="http://localhost:3000/api/webhooks/sepay"

# ------------------------------------------------------------------------------
# 4. DISCORD DEVELOPER APPLICATION (Đăng nhập / Đăng ký bằng Discord)
# ------------------------------------------------------------------------------
# Lấy tại: https://discord.com/developers/applications
# - Tạo "New Application" -> Vào tab "OAuth2"
# - Thêm Redirect URL: http://localhost:3000/api/auth/discord/callback
#   (khi deploy thật: https://yourdomain.com/api/auth/discord/callback)
NEXT_PUBLIC_DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
NEXT_PUBLIC_DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# ------------------------------------------------------------------------------
# 4.1 GITHUB OAUTH APPLICATION (Đăng nhập / Đăng ký bằng GitHub)
# ------------------------------------------------------------------------------
# Lấy tại: https://github.com/settings/developers -> OAuth Apps
# - Thêm Authorization callback URL: http://localhost:3000/api/auth/github/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
NEXT_PUBLIC_GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"

# ------------------------------------------------------------------------------
# 5. GOOGLE IDENTITY SERVICES & YOUTUBE DATA API V3
# ------------------------------------------------------------------------------
# Lấy tại: https://console.cloud.google.com/apis/credentials
# - Bật API: "YouTube Data API v3"
# - Thêm Authorized Javascript Origin: http://localhost:3000, https://yourdomain.com
# - Thêm Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 6. TWITCH HELIX API & EVENTSUB WEBHOOKS
# ------------------------------------------------------------------------------
# Lấy tại: https://dev.twitch.tv/console/apps
# - Thêm OAuth Redirect URL: http://localhost:3000/api/auth/twitch/callback
TWITCH_CLIENT_ID="your-twitch-client-id"
TWITCH_CLIENT_SECRET="your-twitch-client-secret"
NEXT_PUBLIC_TWITCH_REDIRECT_URI="http://localhost:3000/api/auth/twitch/callback"
# Chuỗi bảo mật tự đặt để xác thực chữ ký HMAC-SHA256 từ Twitch EventSub Webhook:
TWITCH_WEBHOOK_SECRET="your-twitch-webhook-secret-string"

# ------------------------------------------------------------------------------
# 7. AES-256-GCM TOKEN ENCRYPTION KEY (Bảo Mật Cấp Ngân Hàng)
# ------------------------------------------------------------------------------
# Chuỗi bí mật 32-byte (64 ký tự Hex) dùng để mã hóa OAuth Token lưu vào Database.
# Tạo nhanh bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 8. APPLICATION BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
